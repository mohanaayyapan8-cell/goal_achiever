# Copy this file to ".env" and edit. NEVER commit ".env" to GitHub.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Kolkata
# Leave empty to use SQLite. For PostgreSQL later:
# DATABASE_URL=postgres://user:password@localhost:5432/goal_achiever
DATABASE_URL=
# Email (console prints emails in the terminal; good for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Goal Achiever <noreply@example.com>

# OPTIONAL: AI feedback on written answers (off if empty). Using it sends the question and
# your answer to the Anthropic API. It never changes your rubric score.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Address of your site, used for links inside reminder emails.
SITE_URL=http://127.0.0.1:8000
